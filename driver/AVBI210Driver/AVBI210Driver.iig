// AVBI210Driver.iig - PCIDriverKit service for the Intel I210 AVB adapter
// (PCI 8086:1533, subsystem 1ab6:0214). Phase 0b: SYSTIM clock and TIMINCA
// frequency adjust, per-packet RX timestamps in the receive buffer, the TX
// timestamp latch and a minimal one-queue polled datapath, all driven through
// AVBI210UserClient.

#ifndef AVBI210Driver_h
#define AVBI210Driver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <DriverKit/IOTimerDispatchSource.iig>

class AVBI210Driver : public IOService
{
public:
    virtual bool
    init() override;

    virtual void
    free() override;

    virtual kern_return_t
    Start(IOService * provider) override;

    virtual kern_return_t
    Stop(IOService * provider) override;

    virtual kern_return_t
    NewUserClient(uint32_t type, IOUserClient ** userClient) override;

    // Entry point for AVBI210UserClient. Always called on this driver's
    // default queue, so it is serialized with TimerFired and Start/Stop.
    kern_return_t
    HandleUserMethod(uint64_t selector, IOUserClientMethodArguments * arguments) LOCALONLY;

    // 2 ms poll timer: harvests the RX queue and the pending TX timestamp.
    virtual void
    TimerFired(OSAction * action, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};

#endif /* AVBI210Driver_h */
